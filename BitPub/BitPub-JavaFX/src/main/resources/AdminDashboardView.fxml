<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.AdminDashboardController">
   <children>
      <VBox spacing="15.0" layoutX="20.0" layoutY="20.0" prefHeight="560.0" prefWidth="760.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label text="Dashboard Amministratore - Gestione Locali">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="25.0" prefHeight="25.0"/>
               </children>
            </HBox>
            
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnNuovoLocale" mnemonicParsing="false" onAction="#handleNuovoLocale" text="Nuovo Locale" />
                  <Button fx:id="btnModifica" mnemonicParsing="false" onAction="#handleModifica" text="Modifica" disable="true" />
                  <Button fx:id="btnElimina" mnemonicParsing="false" onAction="#handleElimina" text="Elimina" disable="true" />
                  <Button mnemonicParsing="false" onAction="#caricaDati" text="Aggiorna Dati" />
               </children>
            </HBox>
            
            <TableView fx:id="localiTable" prefHeight="450.0" prefWidth="760.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                <TableColumn fx:id="colCitta" prefWidth="150.0" text="Città" />
                <TableColumn fx:id="colIndirizzo" prefWidth="200.0" text="Indirizzo" />
                <TableColumn fx:id="colGestore" prefWidth="100.0" text="ID Gestore" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>