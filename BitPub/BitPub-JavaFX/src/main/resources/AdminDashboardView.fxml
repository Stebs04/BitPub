<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bitpub.controllers.AdminDashboardController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="Gestione Locali BitPub"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30.0" prefHeight="30.0" />
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <!-- Bottoni con stili custom -> ti consiglio di spostare questi colori nel tuo style.css in futuro -->
                        <Button fx:id="btnNuovo" onAction="#handleNuovoLocale" text="➕ Nuovo Locale"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand; -fx-background-radius: 5;" />
                        <Button fx:id="btnModifica" onAction="#handleModifica" text="✏️ Modifica" disable="true"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand; -fx-background-radius: 5;" />
                        <Button fx:id="btnElimina" onAction="#handleElimina" text="🗑️ Elimina" disable="true"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand; -fx-background-radius: 5;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#caricaDati" text="🔄 Aggiorna"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand; -fx-background-radius: 5;" />
                    </children>
                </HBox>

                <TableView fx:id="localiTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome Locale" />
                        <TableColumn fx:id="colCitta" prefWidth="150.0" text="Città" />
                        <TableColumn fx:id="colIndirizzo" prefWidth="300.0" text="Indirizzo Completo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>