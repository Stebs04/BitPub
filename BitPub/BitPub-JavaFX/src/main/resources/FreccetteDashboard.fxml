<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="30.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bitpub.controllers.FreccetteDashboardController"
      style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI', sans-serif;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="🎯 Partita Freccette (501)" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

    <HBox alignment="CENTER" spacing="80.0">
        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 40; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Label fx:id="lblGiocatore1" text="Giocatore 1" style="-fx-font-size: 20px; -fx-text-fill: #64748b; -fx-font-weight: bold;" />
            <Label fx:id="lblPunteggio1" text="501" style="-fx-font-size: 60px; -fx-font-weight: 900; -fx-text-fill: #d32f2f;" />
            <ProgressBar fx:id="progressGiocatore1" progress="1.0" prefWidth="250.0" prefHeight="20.0" style="-fx-accent: #d32f2f;" />
        </VBox>

        <Label text="STATISTICHE" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />

        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20 40; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <HBox spacing="40" alignment="CENTER">
                <VBox alignment="CENTER">
                    <Label text="Totale 180s" style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;" />
                    <Label fx:id="labelTotale180" text="..." style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" />
                </VBox>
                <VBox alignment="CENTER">
                    <Label text="Media Punti" style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;" />
                    <Label fx:id="labelMediaPunti" text="..." style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <VBox alignment="CENTER" spacing="15.0">
        <Label fx:id="statoLabel" text="In attesa di connessione..." style="-fx-font-size: 14px; -fx-font-style: italic; -fx-text-fill: #64748b;" />
        <Button fx:id="bottoneAggiorna" text="🔄 Ricarica Statistiche" onAction="#caricaStatisticheFreccette"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;" />
    </VBox>
    
    <TableView fx:id="tabellaPartite" prefHeight="250.0" prefWidth="800.0" style="-fx-background-radius: 8;" />
</VBox>