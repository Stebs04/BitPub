<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.RegistrazioneController"
      prefHeight="600.0" prefWidth="800.0">
   
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>

   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Crea il tuo Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <Label text="Unisciti alla community di BitPub per iniziare a giocare" style="-fx-text-fill: #64748b;" />
         </children>
      </VBox>
      
      <VBox maxWidth="380.0" spacing="12.0">
         <children>
            <Label text="Username" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="usernameField" prefHeight="40.0" promptText="Scegli un username unico" />
            
            <Label text="Email" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="emailField" prefHeight="40.0" promptText="Indirizzo email" />

            <Label text="Password" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Minimo 8 caratteri" />

            <Label text="Conferma Password" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <PasswordField fx:id="confermaPasswordField" prefHeight="40.0" promptText="Ripeti la password" />

            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleRegistrazione" 
                    prefHeight="45.0" prefWidth="380.0" text="Registrati" 
                    styleClass="button-primary">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            
            <Label fx:id="erroreLabel" alignment="CENTER" maxWidth="Infinity" textFill="#ef4444" wrapText="true">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Hai già un account?" style="-fx-text-fill: #64748b;" />
            <Hyperlink onAction="#tornaAlLogin" text="Torna al Login" />
         </children>
      </HBox>
   </children>
</VBox>