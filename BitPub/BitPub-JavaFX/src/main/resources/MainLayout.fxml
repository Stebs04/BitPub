<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="768.0" prefWidth="1200.0" style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.MainController">

    <left>
        <VBox prefWidth="240" spacing="10" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="30" right="15" bottom="20" left="15"/>
            </padding>

            <VBox spacing="5" style="-fx-padding: 0 0 30 0;">
                <Label text="BITPUB" style="-fx-text-fill: #f8fafc; -fx-font-size: 26px; -fx-font-weight: 900; -fx-letter-spacing: 2px;"/>
                <Label text="MANAGEMENT SYSTEM" style="-fx-text-fill: #3b82f6; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
            </VBox>

            <Label text="MODULI" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 0 0 5 5;"/>

            <Button fx:id="btnDashboard" text="📊 Dashboard" onAction="#mostraDashboard" maxWidth="Infinity" styleClass="sidebar-btn" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button fx:id="btnCalciobalilla" text="⚽ Calciobalilla" onAction="#mostraCalciobalilla" maxWidth="Infinity" styleClass="sidebar-btn" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button fx:id="btnFreccette" text="🎯 Freccette" onAction="#mostraFreccette" maxWidth="Infinity" styleClass="sidebar-btn" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button fx:id="btnBiliardo" text="🎱 Biliardo" onAction="#mostraBiliardo" maxWidth="Infinity" styleClass="sidebar-btn" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-background-color: #334155;"/>
            <VBox spacing="5" style="-fx-padding: 15 5 0 5;">
                <Label fx:id="statusLabel" text="Stato: Connesso" style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label text="BitPub Edge v2.0" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>