<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bitpub.controllers.CalciobalillaDashboardController"
      style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI', 'Roboto', sans-serif;">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="Data Dashboard - Calciobalilla" style="-fx-font-size: 38px; -fx-font-weight: 900; -fx-text-fill: #f8fafc;">
            <effect><DropShadow color="#ffffff20" offsetY="2" radius="4" /></effect>
        </Label>
        <Label text="POWERED BY CLOUD &amp; HATEOAS" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #818cf8; -fx-background-color: #1e1b4b; -fx-padding: 6 15; -fx-background-radius: 15; -fx-letter-spacing: 2px;" />
    </VBox>

    <Label fx:id="statoLabel" text="In attesa di sincronizzazione col Cloud..." style="-fx-font-size: 16px; -fx-text-fill: #94a3b8; -fx-font-style: italic;" />

    <HBox alignment="CENTER" spacing="30.0">
        <Label fx:id="labelVittorieRossi" text="Vittorie Squadra Rossa: --"
               style="-fx-font-size: 16px; -fx-text-fill: #fca5a5; -fx-font-weight: bold; -fx-background-color: #1e293b; -fx-padding: 15 25; -fx-background-radius: 12; -fx-border-color: #991b1b; -fx-border-width: 2; -fx-border-radius: 10;">
            <effect><DropShadow color="#ef444440" offsetY="4" radius="8" /></effect>
        </Label>

        <Label fx:id="labelFalliTotali" text="Falli Totali (Rullate): --"
               style="-fx-font-size: 16px; -fx-text-fill: #fde047; -fx-font-weight: bold; -fx-background-color: #1e293b; -fx-padding: 15 25; -fx-background-radius: 12; -fx-border-color: #854d0e; -fx-border-width: 2; -fx-border-radius: 10;">
            <effect><DropShadow color="#f59e0b40" offsetY="4" radius="8" /></effect>
        </Label>

        <Label fx:id="labelVittorieBlu" text="Vittorie Squadra Blu: --"
               style="-fx-font-size: 16px; -fx-text-fill: #93c5fd; -fx-font-weight: bold; -fx-background-color: #1e293b; -fx-padding: 15 25; -fx-background-radius: 12; -fx-border-color: #1e40af; -fx-border-width: 2; -fx-border-radius: 10;">
            <effect><DropShadow color="#3b82f640" offsetY="4" radius="8" /></effect>
        </Label>
    </HBox>

    <VBox style="-fx-background-color: #1e293b; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #334155; -fx-border-width: 2;">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="#000000cc" height="40.0" radius="19.5" width="40.0" offsetY="10.0" />
        </effect>
        <ListView fx:id="listaPartite" prefHeight="280.0" prefWidth="750.0"
                  style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-padding: 15; -fx-font-size: 16px; -fx-text-fill: #f1f5f9;" />
    </VBox>

    <HBox alignment="CENTER" spacing="25.0">
        <VBox.margin><Insets top="15.0" /></VBox.margin>

        <Button fx:id="btnDettagliSquadra" text="Scopri Dettagli HATEOAS" disable="true"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 10; -fx-cursor: hand;">
            <effect><DropShadow color="#3b82f680" offsetY="5" radius="10" /></effect>
        </Button>

        <Button fx:id="btnProssimoMatch" text="Prenota Prossimo Match" disable="true"
                style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 10; -fx-cursor: hand;">
            <effect><DropShadow color="#f59e0b80" offsetY="5" radius="10" /></effect>
        </Button>
    </HBox>

    <Button text="Aggiorna Dati dal Cloud" onAction="#caricaDatiCalciobalilla"
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 10; -fx-cursor: hand;">
        <VBox.margin><Insets top="15.0" /></VBox.margin>
        <effect><DropShadow color="#10b98180" offsetY="5" radius="10" /></effect>
    </Button>

</VBox>