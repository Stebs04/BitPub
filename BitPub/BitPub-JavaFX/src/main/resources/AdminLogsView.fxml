<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Colleghiamo la vista al suo Controller e applichiamo lo stile CSS -->
<VBox spacing="20.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.AdminLogsController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Titolo della sezione -->
    <Label text="Audit Trail e Log di Sistema" style="-fx-font-weight: bold;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <!-- Barra dei filtri e azioni -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Filtra per livello:" />
        <ComboBox fx:id="filterLevelCombo" prefWidth="150.0" promptText="Seleziona..." />

        <!-- Pulsante di aggiornamento collegato al metodo refreshLogs() del controller -->
        <Button mnemonicParsing="false" onAction="#refreshLogs" text="Aggiorna Dati" />
    </HBox>

    <!-- Tabella per la visualizzazione dei log -->
    <TableView fx:id="logsTable" VBox.vgrow="ALWAYS">
        <columns>
            <!-- Le colonne sono collegate ai campi del modello SystemLog tramite i loro fx:id -->
            <TableColumn fx:id="colTimestamp" prefWidth="180.0" text="Data e Ora" />
            <TableColumn fx:id="colLevel" prefWidth="100.0" text="Livello" />
            <TableColumn fx:id="colSource" prefWidth="120.0" text="Sorgente" />
            <TableColumn fx:id="colMessage" prefWidth="400.0" text="Messaggio" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>