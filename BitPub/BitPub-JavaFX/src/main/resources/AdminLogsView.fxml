<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.AdminLogsController">

   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox>
               <children>
                  <Label text="Log di Sistema" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Monitoraggio in tempo reale degli eventi del backend Edge e Cloud" style="-fx-text-fill: #64748b;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
         <children>
            <Label text="Filtra per Livello:" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
            
            <ComboBox fx:id="filterLevelCombo" prefWidth="180.0" promptText="Seleziona Livello..." style="-fx-background-radius: 5;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#refreshLogs" styleClass="button-primary" text="🔄 Aggiorna Log" />
         </children>
      </HBox>

      <TableView fx:id="logsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8;">
         <columns>
            <TableColumn fx:id="colTimestamp" prefWidth="180.0" text="Data / Ora" />
            <TableColumn fx:id="colLevel" prefWidth="100.0" text="Livello" />
            <TableColumn fx:id="colSource" prefWidth="250.0" text="Sorgente (Classe/Modulo)" />
            
            <TableColumn fx:id="colMessage" prefWidth="550.0" text="Dettaglio Messaggio" />
         </columns>
      </TableView>
   </children>
</VBox>