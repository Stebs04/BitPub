<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #1e1e2e; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.LiveScoreboardController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="liveIndicator" text="🔴 LIVE" textFill="#ff4d4d">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label fx:id="gameNameLabel" text="Caricamento..." textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER" spacing="40.0" style="-fx-background-color: #313244; -fx-padding: 20; -fx-background-radius: 10;">
         <children>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label fx:id="player1Label" text="Giocatore 1" textFill="#cdd6f4">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="score1Label" text="0" textFill="#a6e3a1">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Label text="-" textFill="#bac2de">
               <font>
                  <Font name="System Bold" size="48.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label fx:id="player2Label" text="Avversario" textFill="#cdd6f4">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="score2Label" text="0" textFill="#f38ba8">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
      <Label fx:id="statusMessageLabel" text="Attesa aggiornamenti dal tavolo..." textFill="#bac2de" />
      <ProgressIndicator fx:id="progressIndicator" prefHeight="30.0" prefWidth="30.0" />
      <Button fx:id="closeButton" disable="true" mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: #89b4fa; -fx-text-fill: white;" text="Chiudi Tracker">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</VBox>
