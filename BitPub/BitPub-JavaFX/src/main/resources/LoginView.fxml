<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.LoginController">
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>
   <children>
      <Label text="Benvenuto in BitPub" textFill="#f8fafc">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </Label>
      
      <Label text="Accedi per gestire il tuo pub" textFill="#94a3b8">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
      </Label>

      <TextField fx:id="usernameField" maxWidth="350.0" prefHeight="45.0" promptText="Username" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-padding: 10 15;" />
      
      <PasswordField fx:id="passwordField" maxWidth="350.0" prefHeight="45.0" promptText="Password" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-padding: 10 15;" />

      <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="45.0" prefWidth="350.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Accedi">
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
         <font>
            <Font size="15.0" />
         </font>
      </Button>

      <Label fx:id="erroreLabel" textFill="#ef4444" wrapText="true" alignment="CENTER" maxWidth="350.0">
         <font>
            <Font size="13.0" />
         </font>
         <VBox.margin>
            <Insets top="5.0" bottom="5.0" />
         </VBox.margin>
      </Label>

      <Hyperlink onAction="#vaiARegistrazione" text="Non hai un account? Registrati ora" textFill="#3b82f6" underline="true">
         <font>
            <Font size="14.0" />
         </font>
      </Hyperlink>
   </children>
</VBox>