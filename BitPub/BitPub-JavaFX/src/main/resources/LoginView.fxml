<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Athor: Stefano Bellan 20054330 -->

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.LoginController"
      prefHeight="600.0" prefWidth="800.0">
   
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>

   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="BitPub Cloud" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <Label text="Inserisci le tue credenziali per accedere" style="-fx-text-fill: #64748b;" />
         </children>
      </VBox>
      
      <VBox maxWidth="350.0" spacing="15.0">
         <children>
            <TextField fx:id="usernameField" prefHeight="45.0" promptText="Username" 
                       style="-fx-background-radius: 8; -fx-padding: 10;" />
            
            <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Password" 
                           style="-fx-background-radius: 8; -fx-padding: 10;" />

            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleLogin" 
                    prefHeight="45.0" prefWidth="350.0" text="Accedi" 
                    styleClass="button-primary" />
            
            <Label fx:id="erroreLabel" alignment="CENTER" maxWidth="Infinity" textFill="#ef4444" wrapText="true">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Non hai un account?" style="-fx-text-fill: #64748b;" />
            <Hyperlink onAction="#vaiARegistrazione" text="Registrati ora" />
         </children>
      </HBox>
   </children>
</VBox>