<?xml version="1.0" encoding="UTF-8"?>

<!--
  FILE 2: FoosballScoreboard.fxml
  Descrizione: Tabellone segnapunti per la partita di Calciobalilla.
  Mostra i gol in tempo reale, lo stato della partita e la barra di avanzamento verso la vittoria.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #121212;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bitpub.controllers.FoosballScoreboardController"
      prefHeight="600.0" prefWidth="800.0">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Intestazione con lo stato della partita -->
    <VBox alignment="CENTER" spacing="10.0">
        <Label fx:id="lblStatus" text="IN ATTESA..." textFill="#FFD700">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        <ProgressBar fx:id="progressMatch" prefWidth="400.0" progress="0.0"
                     style="-fx-accent: #4caf50;" />
    </VBox>

    <!-- Area dei Punteggi: HBox con due colonne simmetriche -->
    <HBox alignment="CENTER" spacing="50.0" VBox.vgrow="ALWAYS">

        <!-- Squadra Blu (Sinistra) -->
        <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #1a237e; -fx-background-radius: 20;">
            <Label text="SQUADRA BLU" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
            <Label fx:id="lblScoreBlue" text="0" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="120.0" />
                </font>
            </Label>
            <padding>
                <Insets bottom="20.0" top="20.0" />
            </padding>
        </VBox>

        <!-- Squadra Rossa (Destra) -->
        <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #b71c1c; -fx-background-radius: 20;">
            <Label text="SQUADRA ROSSA" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
            <Label fx:id="lblScoreRed" text="0" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="120.0" />
                </font>
            </Label>
            <padding>
                <Insets bottom="20.0" top="20.0" />
            </padding>
        </VBox>

    </HBox>

    <!-- Pulsante di ritorno (inizialmente nascosto, gestito dal controller) -->
    <StackPane prefHeight="60.0">
        <Button fx:id="btnBackToDashboard" managed="false" visible="false"
                text="Torna alla Dashboard"
                onAction="#handleBackToDashboard"
                prefWidth="300.0" prefHeight="50.0"
                style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </StackPane>

</VBox>