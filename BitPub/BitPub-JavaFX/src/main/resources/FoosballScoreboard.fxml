<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="40.0" style="-fx-background-color: #0f172a;" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.FoosballScoreboardController">
   
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>

   <children>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="lblStatus" text="CONNESSIONE IN CORSO..." textFill="#94a3b8">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="80.0">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label text="SQUADRA BLU" textFill="#3b82f6">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblScoreBlue" text="0" textFill="WHITE" style="-fx-font-size: 180px; -fx-font-weight: bold;">
                     <styleClass>
                        <String fx:value="score-label" />
                     </styleClass>
                  </Label>
               </children>
            </VBox>

            <Label text=":" textFill="#334155" style="-fx-font-size: 120px; -fx-font-weight: bold;" />

            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label text="SQUADRA ROSSA" textFill="#ef4444">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblScoreRed" text="0" textFill="WHITE" style="-fx-font-size: 180px; -fx-font-weight: bold;">
                     <styleClass>
                        <String fx:value="score-label" />
                     </styleClass>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox alignment="CENTER" spacing="15.0" maxWidth="800.0">
         <children>
            <ProgressBar fx:id="progressWin" prefHeight="30.0" prefWidth="800.0" progress="0.0" 
                         style="-fx-accent: #10b981; -fx-control-inner-background: #1e293b;" />
            <Label text="OBIETTIVO: 10 GOL" textFill="#475569" style="-fx-font-weight: bold;" />
         </children>
      </VBox>

      <Button fx:id="btnBackToDashboard" managed="false" visible="false" mnemonicParsing="false" 
              onAction="#handleBackToDashboard" prefHeight="60.0" prefWidth="300.0" 
              styleClass="button-secondary" text="TORNA ALLA DASHBOARD">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
   </children>
</VBox>