<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.bitpub.controllers.GestoreDashboardController" prefWidth="800" prefHeight="600">
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            
            <Tab text="Macchine Attive">
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="Stato Macchine in Real-Time" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="macchineTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMacchinaNome" text="Nome Macchina" prefWidth="200"/>
                            <TableColumn fx:id="colMacchinaTipo" text="Tipo Gioco" prefWidth="200"/>
                            <TableColumn fx:id="colMacchinaStato" text="Stato (Attiva)" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Partite in Corso">
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="Partite Attualmente in Corso" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="partiteTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPartitaTipo" text="Tipo Gioco" prefWidth="150"/>
                            <TableColumn fx:id="colPartitaGiocatori" text="Giocatori" prefWidth="200"/>
                            <TableColumn fx:id="colPartitaInizio" text="Ora Inizio" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Statistiche e Tornei">
                <HBox spacing="20" style="-fx-padding: 20;">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Statistiche Odierne" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <PieChart fx:id="statisticheChart" prefHeight="300"/>
                        <Label fx:id="lblMediaDurata" text="Media Durata Partita: -- min"/>
                    </VBox>
                    <Separator orientation="VERTICAL" />
                    <VBox spacing="10" prefWidth="300">
                        <Label text="Crea Nuovo Torneo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtNomeTorneo" promptText="Nome Torneo"/>
                        <ChoiceBox fx:id="choiceTipoGioco" prefWidth="300"/>
                        <DatePicker fx:id="dateInizioTorneo" prefWidth="300" promptText="Data Inizio"/>
                        <TextField fx:id="txtMaxPartecipanti" promptText="Max Partecipanti (es. 16)"/>
                        <ChoiceBox fx:id="choiceModalita" prefWidth="300"/>
                        <Button text="Crea Torneo" onAction="#handleCreaTorneo" prefWidth="300" style="-fx-base: #28a745; -fx-text-fill: white;"/>
                        <Label fx:id="lblTorneoMsg" textFill="green" wrapText="true"/>
                    </VBox>
                </HBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>