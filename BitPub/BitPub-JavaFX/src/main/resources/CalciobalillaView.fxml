<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.Group?>

<BorderPane prefWidth="1000.0" prefHeight="760.0"
            maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bitpub.controllers.CalciobalillaUIController"
            style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;">

    <top>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="30" bottom="20"/>
            </padding>
            <Label text="BITPUB ARENA"
                   style="-fx-font-size: 42px; -fx-font-weight: 900; -fx-text-fill: #f8fafc; -fx-letter-spacing: 4px;">
                <effect><DropShadow color="#ffffff40" radius="10" spread="0.2"/></effect>
            </Label>

            <HBox alignment="CENTER" spacing="120">
                <VBox alignment="CENTER" style="-fx-background-color: #1e293b; -fx-padding: 15 50; -fx-background-radius: 20; -fx-border-color: #ef4444; -fx-border-width: 3; -fx-border-radius: 18;">
                    <effect><DropShadow color="#ef444480" radius="15" spread="0.1" offsetY="5"/></effect>
                    <Label text="RED TEAM" style="-fx-font-size: 26px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                    <Label fx:id="punteggioRosso" text="0" style="-fx-font-size: 90px; -fx-text-fill: #f8fafc; -fx-font-weight: 900;">
                        <effect><DropShadow color="#ef4444" radius="15" spread="0.4"/></effect>
                    </Label>
                </VBox>

                <Label text="VS" style="-fx-font-size: 50px; -fx-text-fill: #64748b; -fx-font-weight: 900;"/>

                <VBox alignment="CENTER" style="-fx-background-color: #1e293b; -fx-padding: 15 50; -fx-background-radius: 20; -fx-border-color: #3b82f6; -fx-border-width: 3; -fx-border-radius: 18;">
                    <effect><DropShadow color="#3b82f680" radius="15" spread="0.1" offsetY="5"/></effect>
                    <Label text="BLUE TEAM" style="-fx-font-size: 26px; -fx-text-fill: #3b82f6; -fx-font-weight: bold;"/>
                    <Label fx:id="punteggioBlu" text="0" style="-fx-font-size: 90px; -fx-text-fill: #f8fafc; -fx-font-weight: 900;">
                        <effect><DropShadow color="#3b82f6" radius="15" spread="0.4"/></effect>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <Pane fx:id="campoDaGioco" maxWidth="1400" maxHeight="700"
                  style="-fx-background-color: linear-gradient(to bottom right, #059669, #064e3b); -fx-border-color: #94a3b8; -fx-border-width: 12; -fx-border-radius: 15; -fx-background-radius: 15;">

                <effect><InnerShadow radius="40" color="#000000d9"/></effect>

                <Rectangle x="0" y="250" width="20" height="200" fill="#1e293b"/>
                <Rectangle x="1380" y="250" width="20" height="200" fill="#1e293b"/>

                <Line startX="700" startY="20" endX="700" endY="680" stroke="#f8fafc" strokeWidth="6" opacity="0.7"/>
                <Circle centerX="700" centerY="350" radius="100" stroke="#f8fafc" strokeWidth="6" fill="transparent" opacity="0.7"/>

                <Rectangle x="20" y="200" width="150" height="300" stroke="#f8fafc" strokeWidth="6" fill="transparent" opacity="0.7"/>
                <Rectangle x="1230" y="200" width="150" height="300" stroke="#f8fafc" strokeWidth="6" fill="transparent" opacity="0.7"/>

                <Group fx:id="squadraRossa">
                    <Line startX="100" startY="20" endX="100" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="85" y="330" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Line startX="250" startY="20" endX="250" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="235" y="230" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="235" y="430" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Line startX="600" startY="20" endX="600" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="585" y="130" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="230" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="330" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="430" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="530" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Line startX="950" startY="20" endX="950" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="935" y="180" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="935" y="330" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="935" y="480" width="30" height="40" fill="#ef4444" arcWidth="10" arcHeight="10"/>
                </Group>

                <Group fx:id="squadraBlu">
                    <Line startX="450" startY="20" endX="450" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="435" y="180" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="435" y="330" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="435" y="480" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Line startX="800" startY="20" endX="800" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="785" y="130" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="230" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="330" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="430" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="530" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Line startX="1150" startY="20" endX="1150" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="1135" y="230" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="1135" y="430" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                    <Line startX="1300" startY="20" endX="1300" endY="680" stroke="#cbd5e1" strokeWidth="12"/>
                    <Rectangle x="1285" y="330" width="30" height="40" fill="#3b82f6" arcWidth="10" arcHeight="10"/>
                </Group>

                <Circle fx:id="pallina" centerX="700" centerY="350" radius="18" fill="#facc15">
                    <effect><DropShadow radius="12" color="#00000099" offsetY="6"/></effect>
                </Circle>
            </Pane>

            <Label fx:id="messaggioCentrale" text="" visible="false"
                   style="-fx-font-size: 80px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(0,0,0,0.85); -fx-padding: 30 60; -fx-background-radius: 25; -fx-border-color: #ffffff; -fx-border-width: 4; -fx-border-radius: 25;"/>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="50">
            <padding><Insets top="35" bottom="40"/></padding>
            <Button fx:id="btnAvviaPausa" text="▶ AVVIA PARTITA" onAction="#togglePartita"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 12; -fx-cursor: hand;">
                <effect><DropShadow color="#10b98180" offsetY="5" radius="10"/></effect>
            </Button>

            <Button text="🔄 RESET MATCH" onAction="#resetMatch"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 12; -fx-cursor: hand;">
                <effect><DropShadow color="#64748b80" offsetY="5" radius="10"/></effect>
            </Button>
        </HBox>
    </bottom>
</BorderPane>