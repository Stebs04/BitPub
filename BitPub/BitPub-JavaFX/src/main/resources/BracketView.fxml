<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bitpub.controllers.BracketUIController"
            stylesheets="@style.css">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header-bar">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label fx:id="lblTournamentName" text="Bracket Torneo" styleClass="title-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Aggiorna Bracket" onAction="#loadBracket" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true">
            <HBox fx:id="bracketContainer" spacing="50" alignment="CENTER_LEFT">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                <!-- Bracket columns sarano generate dinamicamente -->
            </HBox>
        </ScrollPane>
    </center>

</BorderPane>
