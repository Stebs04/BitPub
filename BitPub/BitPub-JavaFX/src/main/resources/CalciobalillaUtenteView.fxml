<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.CalciobalillaUtenteController"
      prefHeight="768.0" prefWidth="1024.0">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#tornaAllaDashboard" styleClass="button-secondary" text="⬅ Dashboard" />
                <VBox>
                    <children>
                        <Label text="Arena Calciobalilla" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="Gestisci le tue partite e partecipa ai tornei della community" style="-fx-text-fill: #64748b;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <tabs>
                <Tab text="Partite e Record">
                    <content>
                        <HBox spacing="30.0" padding="30">
                            <children>
                                <VBox spacing="20.0" prefWidth="400.0" alignment="TOP_CENTER" style="-fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0; -fx-padding: 0 30 0 0;">
                                    <children>
                                        <Label text="Pronto a scendere in campo?" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                        <Button fx:id="btnGiocaOra" mnemonicParsing="false" onAction="#handleGiocaPartita" 
                                                prefHeight="80.0" prefWidth="300.0" styleClass="button-primary" text="GIOCA ORA">
                                            <font>
                                                <Font name="System Bold" size="20.0" />
                                            </font>
                                        </Button>
                                        
                                        <Separator prefWidth="200.0" />
                                        
                                        <Label text="I tuoi Record Personali" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                        <GridPane vgap="15.0" hgap="10.0" alignment="CENTER">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            </columnConstraints>
                                            <children>
                                                <Label text="Vinte / Perse:" GridPane.rowIndex="0" />
                                                <Label fx:id="lblWinLoss" text="-- / --" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                
                                                <Label text="Gol Fatti:" GridPane.rowIndex="1" />
                                                <Label fx:id="lblGolFatti" text="--" style="-fx-font-weight: bold; -fx-text-fill: #16a34a;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                
                                                <Label text="Gol Subiti:" GridPane.rowIndex="2" />
                                                <Label fx:id="lblGolSubiti" text="--" style="-fx-font-weight: bold; -fx-text-fill: #dc2626;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>
                                
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Regole dell'Arena" style="-fx-font-weight: bold;" />
                                        <Label text="1. Le partite amichevoli arrivano a 10 gol." wrapText="true" />
                                        <Label text="2. Il costo della partita viene detratto all'avvio." wrapText="true" />
                                        <Label text="3. Assicurati che il tavolo sia libero prima di avviare." wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <Tab text="Tornei Disponibili">
                    <content>
                        <VBox spacing="20.0" padding="30">
                            <children>
                                <HBox spacing="15.0" alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="txtNomeSquadra" prefWidth="250.0" promptText="Inserisci Nome tua Squadra..." />
                                        <Button mnemonicParsing="false" onAction="#handleIscrizioneTorneo" styleClass="button-primary" text="Iscriviti al Selezionato" />
                                    </children>
                                </HBox>
                                
                                <TableView fx:id="tableTornei" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colNomeTorneo" prefWidth="300.0" text="Nome Torneo" />
                                        <TableColumn fx:id="colDataTorneo" prefWidth="200.0" text="Data Inizio" />
                                        <TableColumn fx:id="colStatoTorneo" prefWidth="200.0" text="Modalità" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>