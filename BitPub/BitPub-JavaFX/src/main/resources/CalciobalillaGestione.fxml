<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.CalciobalillaGestioneController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="Gestione Calciobalilla" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #f8fafc;" />
            <Label text="Interfaccia API e Simulatore Cloud" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblStatoApi" text="API Pronta" style="-fx-background-color: #064e3b; -fx-text-fill: #34d399; -fx-padding: 8 15; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 14px;" />
    </HBox>

    <HBox spacing="15" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1;">
        <Button text="➕ Crea Locale" onAction="#gestisciCreaLocale" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button text="🏆 Crea Torneo" onAction="#gestisciCreaTorneo" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button text="⚽ Avvia Partita (Simulatore)" onAction="#gestisciAvviaPartita" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="🔄 Sincronizza Dati" onAction="#sincronizzaDatiCloud" style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox spacing="15" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label text="Stato Simulatore / Partita Live" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;" />

            <HBox alignment="CENTER" spacing="40" style="-fx-padding: 30 0;">
                <VBox alignment="CENTER" spacing="10">
                    <Label text="SQUADRA ROSSA" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 16px;" />
                    <Label fx:id="lblPunteggioRosso" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 64px; -fx-font-weight: 900;" />
                </VBox>
                <Label text="VS" style="-fx-text-fill: #64748b; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <VBox alignment="CENTER" spacing="10">
                    <Label text="SQUADRA BLU" style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 16px;" />
                    <Label fx:id="lblPunteggioBlu" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 64px; -fx-font-weight: 900;" />
                </VBox>
            </HBox>

            <TextArea fx:id="txtLogEventi" editable="false" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: #0f172a; -fx-text-fill: #34d399; -fx-font-family: 'Courier New'; -fx-border-color: transparent;" promptText="In attesa di eventi MQTT/API..." />
        </VBox>

        <VBox spacing="15" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Dati Cloud HATEOAS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;" />
            <ListView fx:id="listaDati" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #0f172a; -fx-text-fill: #f1f5f9; -fx-font-size: 14px;" />
        </VBox>

    </HBox>

</VBox>