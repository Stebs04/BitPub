<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bitpub.controllers.PlatformAdminDashboardController" stylesheets="@styles.css" styleClass="dashboard-pane">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="BitPub - Piattaforma Globale" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#logout" styleClass="logout-btn"/>
        </HBox>
    </top>
    
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane">
            
            <Tab text="Statistiche Piattaforma">
                <HBox spacing="20">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Metriche Globali (Raw JSON per debug)" styleClass="subtitle"/>
                        <TextArea fx:id="statsArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" styleClass="input-field" style="-fx-font-family: monospace;"/>
                        <Button text="Aggiorna Statistiche" onAction="#loadStats" styleClass="secondary-btn"/>
                    </VBox>
                    
                    <VBox spacing="15" prefWidth="300" styleClass="form-panel">
                        <Label text="Inserimento Match (Debug)" styleClass="subtitle"/>
                        <VBox spacing="5">
                            <Label text="ID Giocatore 1" styleClass="form-label"/>
                            <TextField fx:id="player1Field" promptText="UUID" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="ID Giocatore 2" styleClass="form-label"/>
                            <TextField fx:id="player2Field" promptText="UUID" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="ID Gioco" styleClass="form-label"/>
                            <TextField fx:id="gameIdField" promptText="UUID" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Punteggio G1" styleClass="form-label"/>
                            <TextField fx:id="score1Field" promptText="Es. 10" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Punteggio G2" styleClass="form-label"/>
                            <TextField fx:id="score2Field" promptText="Es. 8" styleClass="input-field"/>
                        </VBox>
                        <Button text="Invia Risultato" onAction="#submitMatch" maxWidth="Infinity" styleClass="primary-btn"/>
                        <Label fx:id="statusLabel" wrapText="true" />
                    </VBox>
                </HBox>
            </Tab>
            
        </TabPane>
    </center>
    
</BorderPane>
