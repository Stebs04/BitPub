<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.AdminSessionsController">

   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBackToDashboard" styleClass="button-secondary" text="⬅ Indietro" />
            
            <VBox>
               <children>
                  <Label text="Monitoraggio Sessioni Attive" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Supervisione e gestione in tempo reale dei tavoli da gioco" style="-fx-text-fill: #64748b;" />
               </children>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <VBox alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
               <children>
                  <Label text="Connessione Hardware" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                  <Label fx:id="lblEdgeStatus" text="Edge: IN ATTESA..." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
         <children>
            <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="button-primary" text="🔄 Ricarica Tabellone" />
         </children>
      </HBox>

      <TableView fx:id="tableActiveSessions" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8;">
         <columns>
            <TableColumn fx:id="colSessionId" prefWidth="80.0" text="ID Sess." />
            <TableColumn fx:id="colGameType" prefWidth="150.0" text="Tipo Gioco" />
            <TableColumn fx:id="colUser" prefWidth="150.0" text="Utente" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Stato" />
            <TableColumn fx:id="colScore" prefWidth="120.0" text="Punteggio" />
            
            <TableColumn fx:id="colActions" prefWidth="150.0" text="Azioni Remote" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>