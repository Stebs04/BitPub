<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" styleClass="root" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.bitpub.controllers.BiliardoController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 0, 0, 0, 5);">
         <children>
            <Button mnemonicParsing="false" onAction="#tornaAllaDashboard" styleClass="button-secondary" text="⬅ Dashboard" />
            <VBox>
               <children>
                  <Label text="Sala Biliardo" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Prenota un tavolo o gestisci la tua sessione attiva" style="-fx-text-fill: #64748b;" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#aggiornaTavoli" styleClass="button-primary" text="🔄 Aggiorna Stato" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tavoliTable" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                    <columns>
                      <TableColumn fx:id="colIdTavolo" prefWidth="100.0" text="Tavolo #" />
                      <TableColumn fx:id="colTipo" prefWidth="200.0" text="Tipologia" />
                      <TableColumn fx:id="colStato" prefWidth="150.0" text="Stato" />
                      <TableColumn fx:id="colTariffa" prefWidth="150.0" text="Tariffa / Ora" />
                      <TableColumn fx:id="colAzione" prefWidth="200.0" text="Azione" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <ProgressIndicator fx:id="loadingIndicator" maxHeight="60.0" maxWidth="60.0" visible="false" />
               </children>
            </StackPane>
            
            <HBox alignment="CENTER" style="-fx-background-color: #f1f5f9; -fx-padding: 15; -fx-background-radius: 8;">
               <children>
                  <Label fx:id="lblInfoSotto" text="Seleziona un tavolo libero per iniziare a giocare. Il costo verrà calcolato sulla durata effettiva." textFill="#475569" wrapText="true" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>