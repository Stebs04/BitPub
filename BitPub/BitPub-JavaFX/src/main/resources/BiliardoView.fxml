<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" styleClass="root" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.bitpub.controllers.BiliardoUIController">
   
   <top>
      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 0, 0, 0, 5);">
          <Label text="Statistiche Biliardo" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
          <HBox spacing="10" alignment="CENTER_LEFT">
              <Label text="Serie Massima Palle:" style="-fx-font-size: 16px;"/>
              <Label fx:id="serieMassimaLabel" text="--" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
          </HBox>
      </VBox>
   </top>

   <center>
      <VBox spacing="10" style="-fx-padding: 30;">
          <Label text="Storico Partite:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
          <ListView fx:id="storicoListView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10;" />
      </VBox>
   </center>
   
   <bottom>
      <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 20 30 30 30;">
          <Button fx:id="btnAggiorna" text="🔄 Aggiorna Dati" onAction="#caricaDatiBiliardo" styleClass="button-primary"/>
          <Label fx:id="statoLabel" text="In attesa..." textFill="#64748b"/>
      </HBox>
   </bottom>

</BorderPane>