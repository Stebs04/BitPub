<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bitpub.controllers.CalciobalillaDashboardController"
      style="-fx-background-color: #111827; -fx-font-family: 'Segoe UI', 'Roboto', sans-serif;">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="8.0">
        <Label text="Dashboard Calciobalilla" style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: #f9fafb;" />
        <Label text="POWERED BY HATEOAS" style="-fx-font-size: 12px; -fx-font-weight: 800; -fx-text-fill: #a5b4fc; -fx-background-color: #312e81; -fx-padding: 4 12; -fx-background-radius: 12; -fx-letter-spacing: 1px;" />
    </VBox>

    <Label fx:id="statoLabel" text="In attesa di connessione..." style="-fx-font-size: 15px; -fx-text-fill: #9ca3af; -fx-font-style: italic;" />

    <VBox style="-fx-background-color: #1f2937; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #374151; -fx-border-width: 1;">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="#00000099" height="30.0" radius="14.5" width="30.0" offsetY="5.0" />
        </effect>

        <ListView fx:id="listaPartite" prefHeight="260.0" prefWidth="700.0"
                  style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-padding: 10; -fx-font-size: 15px; -fx-text-fill: #e5e7eb;" />
    </VBox>

    <HBox alignment="CENTER" spacing="20.0">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>

        <Button fx:id="btnDettagliSquadra" text="Scopri Dettagli Squadra" disable="true"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#2563eb66" offsetY="4" radius="8" />
            </effect>
        </Button>

        <Button fx:id="btnProssimoMatch" text="Prenota Prossimo Match" disable="true"
                style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#d9770666" offsetY="4" radius="8" />
            </effect>
        </Button>
    </HBox>

    <Button text="Aggiorna Dati" onAction="#caricaDatiCalciobalilla"
            style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 8; -fx-cursor: hand;">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
        <effect>
            <DropShadow color="#05966966" offsetY="4" radius="8" />
        </effect>
    </Button>

</VBox>