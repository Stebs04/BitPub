<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unibo.bitpub.javafx.controller.CalciobalillaUIController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Match Calciobalilla" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="30" alignment="CENTER">
        <Label text="Squadra Rossa:" style="-fx-font-size: 18px;"/>
        <Label fx:id="punteggioRosso" text="0" style="-fx-font-size: 24px; -fx-text-fill: red;"/>

        <Label text=" - " style="-fx-font-size: 24px;"/>

        <Label fx:id="punteggioBlu" text="0" style="-fx-font-size: 24px; -fx-text-fill: blue;"/>
        <Label text=":Squadra Blu" style="-fx-font-size: 18px;"/>
    </HBox>

    <Button text="Simula Gol Rosso" onAction="#simulaGol"/>

</VBox>