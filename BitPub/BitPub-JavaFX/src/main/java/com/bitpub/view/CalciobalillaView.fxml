<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>

<BorderPane prefWidth="1920.0" prefHeight="1080.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bitpub.controllers.CalciobalillaUIController"
            style="-fx-background-color: #1a1a1a;">

    <top>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="30" bottom="20"/>
            </padding>
            <Label text="BITPUB ARENA - CALCIOBALILLA"
                   style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-letter-spacing: 5px;"/>

            <HBox alignment="CENTER" spacing="100">
                <VBox alignment="CENTER" style="-fx-background-color: rgba(231, 76, 60, 0.1); -fx-padding: 10 40; -fx-background-radius: 20; -fx-border-color: #e74c3c; -fx-border-width: 2;">
                    <Label text="RED TEAM" style="-fx-font-size: 28px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                    <Label fx:id="punteggioRosso" text="0" style="-fx-font-size: 100px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;">
                        <effect><DropShadow color="#e74c3c" radius="20" spread="0.5"/></effect>
                    </Label>
                </VBox>

                <Label text="VS" style="-fx-font-size: 48px; -fx-text-fill: #ffffff; -fx-font-weight: bold;"/>

                <VBox alignment="CENTER" style="-fx-background-color: rgba(52, 152, 219, 0.1); -fx-padding: 10 40; -fx-background-radius: 20; -fx-border-color: #3498db; -fx-border-width: 2;">
                    <Label text="BLUE TEAM" style="-fx-font-size: 28px; -fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                    <Label fx:id="punteggioBlu" text="0" style="-fx-font-size: 100px; -fx-text-fill: #3498db; -fx-font-weight: bold;">
                        <effect><DropShadow color="#3498db" radius="20" spread="0.5"/></effect>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <Pane fx:id="campoDaGioco" maxWidth="1400" maxHeight="700"
                  style="-fx-background-color: linear-gradient(to bottom right, #27ae60, #1e8449); -fx-border-color: #ffffff; -fx-border-width: 10; -fx-border-radius: 10; -fx-background-radius: 10;">

                <effect><InnerShadow radius="30" color="#000000aa"/></effect>

                <Rectangle x="0" y="250" width="20" height="200" fill="#2c3e50"/>
                <Rectangle x="1380" y="250" width="20" height="200" fill="#2c3e50"/>

                <Line startX="700" startY="20" endX="700" endY="680" stroke="white" strokeWidth="5" opacity="0.6"/>
                <Circle centerX="700" centerY="350" radius="100" stroke="white" strokeWidth="5" fill="transparent" opacity="0.6"/>

                <Rectangle x="20" y="200" width="150" height="300" stroke="white" strokeWidth="5" fill="transparent" opacity="0.6"/>
                <Rectangle x="1230" y="200" width="150" height="300" stroke="white" strokeWidth="5" fill="transparent" opacity="0.6"/>

                <Group fx:id="squadraRossa">
                    <Line startX="100" startY="20" endX="100" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="85" y="330" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Line startX="250" startY="20" endX="250" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="235" y="230" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="235" y="430" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Line startX="600" startY="20" endX="600" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="585" y="130" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="230" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="330" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="430" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="585" y="530" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Line startX="950" startY="20" endX="950" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="935" y="180" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="935" y="330" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="935" y="480" width="30" height="40" fill="#e74c3c" arcWidth="10" arcHeight="10"/>
                </Group>

                <Group fx:id="squadraBlu">
                    <Line startX="450" startY="20" endX="450" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="435" y="180" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="435" y="330" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="435" y="480" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Line startX="800" startY="20" endX="800" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="785" y="130" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="230" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="330" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="430" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="785" y="530" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Line startX="1150" startY="20" endX="1150" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="1135" y="230" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Rectangle x="1135" y="430" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                    <Line startX="1300" startY="20" endX="1300" endY="680" stroke="#bdc3c7" strokeWidth="12"/>
                    <Rectangle x="1285" y="330" width="30" height="40" fill="#3498db" arcWidth="10" arcHeight="10"/>
                </Group>

                <Circle fx:id="pallina" centerX="700" centerY="350" radius="15" fill="#f1c40f">
                    <effect><DropShadow radius="10" color="black" offsetY="5"/></effect>
                </Circle>
            </Pane>

            <Label fx:id="messaggioCentrale" text="" visible="false"
                   style="-fx-font-size: 80px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(0,0,0,0.7); -fx-padding: 20 50; -fx-background-radius: 20;"/>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40">
            <padding><Insets top="30" bottom="50"/></padding>
            <Button fx:id="btnAvviaPausa" text="▶ AVVIA PARTITA" onAction="#togglePartita"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 40; -fx-background-radius: 15; -fx-cursor: hand;"/>

            <Button text="🔄 RESET MATCH" onAction="#resetMatch"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 40; -fx-background-radius: 15; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>