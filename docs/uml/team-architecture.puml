@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram - BitPub Team Responsibilities

Person(luca, "Luca Franzon", "Matricola 20054744\nFrontend & Security")
Person(timothy, "Timothy Giolito", "Matricola 20054431\nReal-Time Engine & IoT")
Person(stefano, "Stefano Bellan", "Matricola 20054330\nCore Business & Infra")

System_Boundary(c1, "BitPub Cloud (AWS / On-Premise)") {
    Container(webapp, "BitPub WebApp", "React, TypeScript", "Frontend Application")
    Container(gateway, "API Gateway", "Spring Cloud", "Routing & Security")
    Container(auth_service, "Auth Service", "Spring Boot", "JWT & Login")
    Container(user_service, "User Service", "Spring Boot", "User Management")
    
    Container(locale_service, "Locale Service", "Spring Boot", "Locations Management")
    Container(catalog_service, "Game Catalog Service", "Spring Boot", "Games Catalog")
    Container(tournament_service, "Tournament Service", "Spring Boot", "Tournaments")
    Container(statistics_service, "Statistics Service", "Spring Boot", "Leaderboards")
    Container(notification_service, "Notification Service", "Spring Boot", "Push Notifications")

    Container(match_service, "Match Service", "Spring Boot", "Real-time gameplay engine")
}

System_Boundary(c2, "BitPub Edge") {
    Container(edge_app, "BitPub Edge Node", "Spring Boot", "Local event buffering")
}

System_Ext(simulators, "BitPub Simulators", "Hardware Simulators")
System_Ext(mqtt_broker, "Mosquitto Broker", "MQTT Broker")

Rel_D(luca, webapp, "Develops")
Rel_D(luca, gateway, "Develops")
Rel_D(luca, auth_service, "Develops")
Rel_D(luca, user_service, "Develops")

Rel_D(stefano, locale_service, "Develops")
Rel_D(stefano, catalog_service, "Develops")
Rel_D(stefano, tournament_service, "Develops")
Rel_D(stefano, statistics_service, "Develops")
Rel_D(stefano, notification_service, "Develops")

Rel_D(timothy, match_service, "Develops")
Rel_D(timothy, edge_app, "Develops")
Rel_D(timothy, simulators, "Develops")
Rel_D(timothy, mqtt_broker, "Configures")

@enduml
