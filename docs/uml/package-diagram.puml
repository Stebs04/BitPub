@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram - BitPub System Architecture

Person(player, "Giocatore", "Gioca ai giochi, controlla statistiche e tornei tramite Web App")
Person(admin, "Admin Locale / Piattaforma", "Gestisce macchine, configurazioni e controlla lo stato")

System_Boundary(c1, "BitPub Cloud (AWS / On-Premise)") {
    Container(webapp, "BitPub WebApp", "React 19, TypeScript, Vite", "Interfaccia utente (PWA) per tutti i ruoli")
    
    Container(gateway, "API Gateway", "Spring Cloud Gateway", "Punto di ingresso, routing e validazione JWT")
    
    Container(auth_service, "Auth Service", "Spring Boot", "Gestione autenticazione, emissione token JWT")
    Container(user_service, "User Service", "Spring Boot", "Gestione profili utente e ruoli RBAC")
    Container(locale_service, "Locale Service", "Spring Boot", "Gestione locali fisici e macchine installate")
    Container(catalog_service, "Game Catalog Service", "Spring Boot", "Regole di gioco, tipi di sensori supportati")
    Container(match_service, "Match Service", "Spring Boot", "Motore Real-time, riceve eventi, calcola punteggi")
    Container(tournament_service, "Tournament Service", "Spring Boot", "Gestione tabelloni tornei e iscrizioni")
    Container(statistics_service, "Statistics Service", "Spring Boot", "Aggregazione dati, leaderboard globali")
    Container(notification_service, "Notification Service", "Spring Boot", "Push Notifications (WebSocket) verso client")
    
    ContainerDb(db_pg, "BitPub DB (Shared)", "PostgreSQL 15", "Database relazionale multi-schema")
    Container(cloud_mqtt, "Cloud MQTT Broker", "Mosquitto", "Broker cloud per routing eventi (opzionale se si usa shared mqtt)")
}

System_Boundary(c2, "BitPub Edge (Locale Fisico)") {
    Container(edge_app, "BitPub Edge Node", "Spring Boot", "Riceve MQTT locale, bufferizza e inoltra al Cloud")
    ContainerDb(db_edge, "Edge DB", "SQLite", "Persistenza offline eventi temporanea")
}

System_Ext(simulators, "BitPub Hardware / Simulators", "Simulatori Hardware (Calciobalilla, Freccette, Biliardo)")
System_Ext(mqtt_broker, "Mosquitto Broker", "Eclipse Mosquitto", "Broker MQTT per comunicazione locale")

Rel(player, webapp, "Interagisce", "HTTPS")
Rel(admin, webapp, "Interagisce", "HTTPS")

Rel(webapp, gateway, "API Calls", "HTTPS/JSON")
Rel(webapp, notification_service, "Sottoscrive eventi", "WebSocket (WSS)")

Rel(gateway, auth_service, "Valida token/Login", "HTTPS")
Rel(gateway, match_service, "Inoltra REST", "HTTPS")
Rel(gateway, user_service, "Inoltra REST", "HTTPS")
Rel(gateway, locale_service, "Inoltra REST", "HTTPS")

Rel(auth_service, db_pg, "Legge/Scrive (Schema auth)", "JDBC")
Rel(match_service, db_pg, "Legge/Scrive (Schema match)", "JDBC")
Rel(statistics_service, db_pg, "Legge/Scrive (Schema stats)", "JDBC")

Rel(simulators, mqtt_broker, "Pubblica eventi sensore", "MQTT")
Rel(edge_app, mqtt_broker, "Sottoscrive eventi sensore", "MQTT")
Rel(edge_app, db_edge, "Bufferizza (Offline)", "JDBC")
Rel(edge_app, gateway, "Inoltra eventi (Online)", "HTTPS/REST")

Rel(match_service, notification_service, "Pubblica stato partita", "AMQP/HTTP")
@enduml
