@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightBlue
  BorderColor DarkBlue
}

actor "Giocatore" as Player
actor "LOCALE_ADMIN" as LocaleAdmin
actor "GAME_ADMIN" as GameAdmin
actor "PLATFORM_ADMIN" as PlatformAdmin

rectangle "BitPub Cloud Platform" {
  usecase "Visualizzare Leaderboard Globale" as UC_Stats
  usecase "Iscriversi al Torneo" as UC_Tourney
  usecase "Visualizzare Partite in Tempo Reale" as UC_Live
  
  usecase "Gestire il Proprio Locale Fisico" as UC_Locale
  usecase "Creare Nuove Macchine nel Locale" as UC_Machine
  
  usecase "Gestire Catalogo Giochi e Regole" as UC_Catalog
  
  usecase "Backfill Statistiche e Gestione Globale" as UC_Backfill
  
  usecase "Login / Autenticazione (JWT)" as UC_Auth
}

Player --> UC_Stats
Player --> UC_Tourney
Player --> UC_Live
Player --> UC_Auth

LocaleAdmin --> UC_Locale
LocaleAdmin --> UC_Machine
LocaleAdmin --> UC_Auth

GameAdmin --> UC_Catalog
GameAdmin --> UC_Auth

PlatformAdmin --> UC_Backfill
PlatformAdmin --> UC_Auth

@enduml
