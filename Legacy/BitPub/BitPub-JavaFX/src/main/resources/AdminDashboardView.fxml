<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="root" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bitpub.controllers.AdminDashboardController">

   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox>
               <children>
                  <Label text="Gestione Locali" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Visualizza, crea e modifica le sedi BitPub" style="-fx-text-fill: #64748b;" />
               </children>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button mnemonicParsing="false" onAction="#caricaDati" styleClass="button-secondary" text="🔄 Aggiorna Dati" />
         </children>
      </HBox>

      <HBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
         <children>
            <Button mnemonicParsing="false" onAction="#handleNuovoLocale" styleClass="button-primary" text="➕ Nuovo Locale" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnModifica" disable="true" mnemonicParsing="false" onAction="#handleModifica" styleClass="button-secondary" text="✏️ Modifica" />
            <Button fx:id="btnElimina" disable="true" mnemonicParsing="false" onAction="#handleElimina" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;" text="🗑️ Elimina" />
         </children>
      </HBox>

      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="localiTable" prefHeight="400.0" style="-fx-background-radius: 8; -fx-border-radius: 8;">
              <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome Locale" />
                <TableColumn fx:id="colCitta" prefWidth="200.0" text="Città" />
                <TableColumn fx:id="colIndirizzo" prefWidth="350.0" text="Indirizzo" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <ProgressIndicator fx:id="progressIndicator" visible="false" maxHeight="50.0" maxWidth="50.0" style="-fx-progress-color: #3b82f6;" />
         </children>
      </StackPane>
   </children>
</VBox>