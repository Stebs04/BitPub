<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.uniupo.pissir.bitpub.javafx.controller.KioskController"
            styleClass="root-pane">

    <top>
        <VBox alignment="CENTER" styleClass="header">
            <Label fx:id="gameTitleLabel" styleClass="title" />
            <Label fx:id="statusLabel" styleClass="status" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="scoreboard-container">
            <Label fx:id="timerLabel" styleClass="timer" />
            <HBox alignment="CENTER" spacing="100">
                <VBox alignment="CENTER" styleClass="team-box">
                    <Label text="TEAM A" styleClass="team-name" />
                    <Label fx:id="scoreTeamALabel" styleClass="score" />
                </VBox>
                <VBox alignment="CENTER" styleClass="team-box">
                    <Label text="TEAM B" styleClass="team-name" />
                    <Label fx:id="scoreTeamBLabel" styleClass="score" />
                </VBox>
            </HBox>
            <Label fx:id="eventMessageLabel" styleClass="event-message" />
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" styleClass="promo-container">
            <ImageView fx:id="promoImageView" fitHeight="200" fitWidth="1024" preserveRatio="true" styleClass="promo-image"/>
        </VBox>
    </bottom>

</BorderPane>
